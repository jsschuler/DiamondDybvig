Bootstrap: docker
From: ubuntu:24.04

%post
    export DEBIAN_FRONTEND=noninteractive

    echo "Updating base system..."
    apt-get update && apt-get install -y \
        libfreetype-dev \
        libpng-dev \
        libjpeg-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libtiff-dev \
        libncurses-dev \
        gfortran \
        git \
        build-essential \
        curl \
        wget \
        gnupg \
        libssl-dev \
        libcurl4-openssl-dev \
        libxml2-dev \
        software-properties-common \
        ca-certificates \
        libreadline-dev \
        libncurses-dev \
        libfreetype-dev \
        libpng-dev \
        libjpeg-dev \
        libtiff-dev \
        libharfbuzz-dev \
        libfribidi-dev \
        libfontconfig1-dev

    echo "Installing R 4.5.0..."
    cd /opt && \
    curl -O https://cran.r-project.org/src/base/R-4/R-4.5.0.tar.gz && \
    tar -xzf R-4.5.0.tar.gz && cd R-4.5.0 && \
    ./configure --prefix=/opt/R-4.5.0 --enable-R-shlib --with-blas --with-lapack --without-x && \
    make -j$(nproc) && make install
    ln -s /opt/R-4.5.0/bin/R /usr/local/bin/R
    ln -s /opt/R-4.5.0/bin/Rscript /usr/local/bin/Rscript
    echo "Installing Julia 1.11.4..."
    cd /opt && \
    curl -L -o julia.tar.gz https://julialang-s3.julialang.org/bin/linux/x64/1.11/julia-1.11.4-linux-x86_64.tar.gz && \
    tar -xzf julia.tar.gz && \
    ln -s /opt/julia-1.11.4/bin/julia /usr/local/bin/julia
    #mkdir /opt/.julia
    #mkdir /tmp/.julia
    #mkdir /tmp/.R
    mkdir /opt/project
    cd /opt
    git clone https://github.com/jsschuler/DiamondDybvig 
    julia --project=/opt/project -e 'using Pkg; Pkg.add(["Folds","Distributions","Random","Distributed","CSV","DataFrames","Graphs","StatsBase","JLD2","Dates"]); Pkg.instantiate(); Pkg.precompile()'
    chmod 555 /opt/
    chmod -R 555 /opt/project
    #Rscript -e "install.packages(c('tidyverse', 'data.table', 'Rcpp','ggplot2'), repos='https://cloud.r-project.org')"



%environment
    export PATH=/usr/local/bin:/usr/local/sbin:/usr/bin:/sbin:/bin:/opt/R-4.5.0/bin:/opt/julia-1.11.4/bin
    export R_HOME=/usr/local/lib/R
    export JULIA_DEPOT_PATH=~/.julia

%labels
    Author John S. Schuler
    R_Version 4.5.0
    Julia_Version 1.11.4

%runscript
    mkdir ~/.julia/
    cd /opt/DiamondDybvig/
    julia --project=/opt/project -p `nproc` main0001.jl
    #Rscript analysis.R
